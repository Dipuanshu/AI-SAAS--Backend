NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://aisaas:aisaas@localhost:5432/aisaas
# DATABASE_SSL=true   # set for managed Postgres (Neon, RDS, Supabase ...)

# JWT -- generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated list of allowed origins (Expo web / admin panel). Use * only in dev.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Default free-trial length for newly registered companies
TRIAL_DAYS=14

# Used by `npm run seed` to create the Super Admin account
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@12345

# ---------------------------------------------------------------------------------------------
# AI assistant
# ---------------------------------------------------------------------------------------------
# Choose ONE provider (the first key that is set is used; or force it with LLM_PROVIDER=anthropic|openrouter|mock):
#
#  A) OpenRouter -- has FREE models, good for testing (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=auto            # auto = pick currently free models that support tools, falling back one by one
#                                  # or a list: meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free
#   Any other OpenAI-compatible service also works (Groq, Together, local Ollama):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#   Check your setup with:  npm run llm:test     List free models with:  npm run llm:models
#
#  B) Anthropic (paid) -- best answers (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model. claude-opus-5-5 is the default; claude-sonnet-5-5 or claude-haiku-5-5 are cheaper.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (how much the model thinks; higher = better but slower/more expensive)
ANTHROPIC_EFFORT=medium
# Set to "mock" to try the whole flow without any API key (a simple rule-based stand-in, NOT intelligent).
# LLM_PROVIDER=mock

# Address of THIS API as seen by the company connectors (written into the downloaded package).
# Local test: http://localhost:4000   |   Production: https://api.yourdomain.com
PUBLIC_API_URL=http://localhost:4000

# Optional limits
# CHAT_RATE_PER_MINUTE=20      messages per user per minute
# CHAT_MAX_STEPS=6             tool-call rounds per question
# CHAT_MAX_MESSAGES=120        messages per conversation
# CHAT_TOOL_TIMEOUT_MS=30000   wait for the connector to answer
